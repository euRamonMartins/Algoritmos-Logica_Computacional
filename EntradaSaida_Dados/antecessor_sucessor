#include <stdio.h>

int main() {
    int N;

    printf("Digite um numero: ");
    scanf("%d", &N);

    printf("O antecessor de %d e %d\n", N, N - 1);
    printf("O sucessor de %d e %d\n", N, N + 1);

    return 0;
}
